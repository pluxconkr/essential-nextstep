{
  "expo": {
    "name": "NextStep",
    "slug": "nextstep",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nextstep",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.nextstep.student"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c6b74",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nextstep.student"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c6b74",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1c6b74",
          "defaultChannel": "nextstep-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NextStep uses a screenshot you choose only to confirm a step you finished. Only you and your mentor can see it, and it is deleted after 90 days."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
